{
  "name": "sonda-agent",
  "productName": "Sonda Agent",
  "version": "1.6.0",
  "description": "Yönetici (Claude CLI / Claude API / yerel model / NIM / OpenCode) ürünü tanımlar ve onaylar, Claude Code / Codex / OpenCode kodlar ve inceler, Sonda Agent test eder.",
  "main": "src/main/main.js",
  "author": "Semih",
  "license": "MIT",
  "private": true,
  "scripts": {
    "start": "electron .",
    "dist:mac": "electron-builder --mac --publish never",
    "dist:win": "electron-builder --win --publish never",
    "pack": "electron-builder --dir",
    "pretest": "node -e \"require('electron')\"",
    "test": "node --test \"test/*.test.js\"",
    "lint": "eslint ."
  },
  "dependencies": {
    "cross-spawn": "^7.0.6",
    "mammoth": "^1.12.3",
    "tree-kill": "^1.2.2"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "electron": "^44.4.5",
    "electron-builder": "^26.15.3",
    "eslint": "^10.11.0",
    "globals": "^17.13.0"
  },
  "build": {
    "appId": "com.semih.sonda-agent",
    "productName": "Sonda Agent",
    "files": [
      "src/**/*",
      "!src/renderer/__smoke.html",
      "package.json"
    ],
    "mac": {
      "target": [
        {
          "target": "dmg",
          "arch": [
            "arm64",
            "x64"
          ]
        }
      ],
      "category": "public.app-category.developer-tools"
    },
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    },
    "directories": {
      "buildResources": "build",
      "output": "dist"
    },
    "dmg": {
      "title": "Sonda Agent",
      "iconSize": 96,
      "window": {
        "width": 540,
        "height": 380
      },
      "contents": [
        {
          "x": 140,
          "y": 200
        },
        {
          "x": 400,
          "y": 200,
          "type": "link",
          "path": "/Applications"
        }
      ]
    }
  }
}
